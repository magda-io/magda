{
  "name": "@magda/agent-runtime",
  "version": "7.0.0",
  "description": "Managed DeepSeek Harness runtime for Magda Agent Workspace",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "bash -n entrypoint.sh && node --check bootstrap.mjs && node --check dsh-launch.mjs",
    "build": "yarn run check",
    "test": "yarn run check && node test-runtime.mjs",
    "prepare-docker": "yarn --cwd ../packages/mgd build && test -x ../packages/mgd/bin/mgd.js && yarn test",
    "predocker-build-local": "yarn prepare-docker",
    "docker-build-local": "create-docker-context-for-node-component --build --push --tag auto --local",
    "predocker-build-prod": "yarn prepare-docker",
    "docker-build-prod": "create-docker-context-for-node-component --build --push --tag auto",
    "retag-and-push": "retag-and-push"
  },
  "dependencies": {
    "@magda/mgd": "^7.0.0"
  },
  "devDependencies": {
    "@magda/scripts": "^7.0.0"
  },
  "config": {
    "docker": {
      "name": "magda-agent-runtime",
      "include": "node_modules Dockerfile ../magda-agent-runtime/dsh-client-managed-profile ../magda-agent-runtime/magda.cordis.patch.yml ../magda-agent-runtime/entrypoint.sh ../magda-agent-runtime/bootstrap.mjs ../magda-agent-runtime/dsh-launch.mjs"
    }
  },
  "magda": {
    "language": "typescript",
    "categories": {
      "dockerizedTool": true
    }
  }
}
