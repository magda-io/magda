  "settings": {
    "analysis": {
      "analyzer": {
        "english_with_synonym": {
          "filter": ["lowercase", "english_possessive_stemmer", "light_english_stemmer", "synonym", "english_possessive_stemmer", "english_stop"],
          "tokenizer": "standard",
          "type": "custom"
        },
        "english_with_synonym_strip_html": {
          "char_filter": ["html_strip"],
          "filter": ["lowercase", "english_possessive_stemmer", "light_english_stemmer", "synonym", "english_possessive_stemmer", "english_stop"],
          "tokenizer": "standard",
          "type": "custom"
        },
        "english_without_synonym_for_search": {
          "filter": ["lowercase", "english_possessive_stemmer", "light_english_stemmer", "english_stop"],
          "tokenizer": "standard",
          "type": "custom"
        },
        "magda_edge_ngram": {
          "filter": ["lowercase", "magda_edge_ngram_filter"],
          "tokenizer": "standard",
          "type": "custom"
        },
        "quote": {
          "filter": ["lowercase"],
          "tokenizer": "keyword",
          "type": "custom"
        },
        "quote_partial_match": {
          "filter": ["lowercase"],
          "tokenizer": "standard",
          "type": "custom"
        },
        "uppercase": {
          "filter": ["uppercase"],
          "tokenizer": "keyword",
          "type": "custom"
        }
      },
      "filter": {
        "english_possessive_stemmer": {
          "name": "possessive_english",
          "type": "stemmer"
        },
        "english_stop": {
          "stopwords": "_english_",
          "type": "stop"
        },
        "light_english_stemmer": {
          "name": "light_english",
          "type": "stemmer"
        },
        "magda_edge_ngram_filter": {
          "max_gram": 20,
          "min_gram": 1,
          "type": "edge_ngram"
        },
        "synonym": {
          "format": "wordnet",
          "synonyms_path": "analysis/wn_s.pl",
          "type": "synonym"
        }
      }
    },
    "index": {
      "knn": true,
      "number_of_replicas": 0,
      "number_of_shards": 1,
      "search.idle.after": "60s"
    }
