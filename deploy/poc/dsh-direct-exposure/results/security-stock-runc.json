{
  "variant": "stock",
  "user": "bob",
  "checks": [
    {
      "name": "anonymous HTTP to the agent route is rejected by Magda before DSH",
      "ok": true,
      "status": 401,
      "body": "Magda authentication required"
    },
    {
      "name": "anonymous WebSocket upgrade is rejected before upgrade",
      "ok": true,
      "status": 401,
      "body": "Magda authentication required"
    },
    {
      "name": "forged Magda session cookie is rejected",
      "ok": true,
      "status": 401
    },
    {
      "name": "authenticated index loads",
      "ok": true,
      "status": 200
    },
    {
      "name": "no DSH token or DSH cookie reaches the browser",
      "ok": true,
      "setCookieNames": [
        "connect.sid"
      ]
    },
    {
      "name": "agent mount carries the relaxed CSP (script-src 'unsafe-inline' 'unsafe-eval')",
      "ok": true,
      "scriptSrc": "'self' 'unsafe-inline' 'unsafe-eval'"
    },
    {
      "name": "other Magda paths keep the strict CSP (script-src 'self', no unsafe-*)",
      "ok": true,
      "whoami": "'self'",
      "siblingPath": "'self'"
    },
    {
      "name": "authenticated same-origin WebSocket upgrade succeeds",
      "ok": true,
      "status": 101
    },
    {
      "name": "authenticated same-origin RPC succeeds",
      "ok": true,
      "status": 200
    },
    {
      "name": "cross-site Origin WebSocket is rejected by the gateway before Agent Manager / DSH",
      "ok": true,
      "status": 403,
      "body": "WebSocket Origin not allowed.",
      "reachedAgentManager": false
    },
    {
      "name": "cross-site Origin RPC is rejected by DSH",
      "ok": true,
      "status": 403
    },
    {
      "name": "Sec-Fetch-Site: cross-site RPC is rejected by DSH",
      "ok": true,
      "status": 403
    },
    {
      "name": "undeclared external Host does not reach Magda (ingress host rule)",
      "ok": true,
      "status": 404
    },
    {
      "name": "Service: without the DSH cookie every route needs authentication",
      "ok": true,
      "indexDeclared": 401,
      "indexUndeclared": 401,
      "apiDeclared": 401,
      "apiUndeclared": 403,
      "apiLoopbackHost": 401,
      "wsDeclared": 401,
      "wsUndeclaredHost": 403,
      "wsForeignOrigin": 403
    },
    {
      "name": "Service: undeclared Host /api -> 403 (fence before auth)",
      "ok": true
    },
    {
      "name": "stock DSH keeps its cookie-signing secret on the PVC",
      "ok": true
    },
    {
      "name": "launch token is redacted from the Pod log (hand-off via file + pods/exec)",
      "ok": true
    }
  ],
  "sandbox": "bob-3",
  "template": "dsh-runc-stock",
  "agentManagerAuthMode": "managed-cookie",
  "csp": {
    "agentMount": "'self' 'unsafe-inline' 'unsafe-eval'",
    "whoami": "'self'",
    "siblingPath": "'self'"
  },
  "serviceLevel": {
    "indexDeclared": 401,
    "indexUndeclared": 401,
    "apiDeclared": 401,
    "apiUndeclared": 403,
    "apiLoopbackHost": 401,
    "wsDeclared": 401,
    "wsUndeclaredHost": 403,
    "wsForeignOrigin": 403
  }
}