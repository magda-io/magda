{
  "name": "@magda/agent-manager",
  "version": "7.0.0",
  "type": "module",
  "exports": "./dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist tsconfig.tsbuildinfo",
    "build": "yarn run compile",
    "compile": "tsc -b && ts-module-alias-transformer dist",
    "start": "node dist/index.js",
    "dev": "run-typescript-in-nodemon src/index.ts",
    "docker-build-local": "create-docker-context-for-node-component --build --push --tag auto --local",
    "docker-build-prod": "create-docker-context-for-node-component --build --push --tag auto",
    "test": "c8 mocha",
    "retag-and-push": "retag-and-push"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.1.0",
    "@magda/esm-utils": "^1.0.1",
    "@magda/typescript-common": "^7.0.0",
    "express": "^4.21.2",
    "http-terminator": "^3.2.0",
    "jsonwebtoken": "^9.0.2",
    "yargs": "^12.0.5"
  },
  "devDependencies": {
    "@magda/scripts": "^7.0.0",
    "@types/chai": "^4.3.11",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "9.0.5",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^2.0.16",
    "@types/yargs": "^12.0.8",
    "chai": "^5.0.0-rc.0",
    "mocha": "^10.2.0",
    "supertest": "^6.3.3",
    "typescript": "~5.3.3"
  },
  "mocha": {
    "import": "tsx/esm",
    "spec": [
      "src/test/**/*.spec.ts"
    ]
  },
  "config": {
    "docker": {
      "name": "magda-agent-manager",
      "include": "node_modules dist Dockerfile package.json"
    }
  },
  "magda": {
    "language": "typescript",
    "categories": {
      "api": true,
      "stateless": true
    }
  },
  "_moduleMappings": {
    "magda-typescript-common/src": "@magda/typescript-common/dist"
  }
}
